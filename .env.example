# Example .env file for Cosy Docker deployment
# Copy to .env and set your values

# API key for bearer token authentication
# If set, all API endpoints (except /api/health) require:
#   Authorization: Bearer <COSY_API_KEY>
# If empty, auth is disabled (dev mode only!)
COSY_API_KEY=changeme-use-a-strong-secret

# Log level: error, warn, info, debug, trace
RUST_LOG=info
