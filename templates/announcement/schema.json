{
  "id": "announcement",
  "name": "Announcement",
  "description": "Product/news announcement",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "tag": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "headline": {
      "type": "text",
      "required": true,
      "max": 150,
      "wrap_width": 35
    },
    "detail": {
      "type": "text",
      "required": false,
      "max": 200,
      "wrap_width": 50
    },
    "date": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}