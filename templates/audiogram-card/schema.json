{
  "id": "audiogram-card",
  "name": "Audiogram Card",
  "dimensions": { "width": 1080, "height": 1350 },
  "fonts": ["Space Grotesk", "Inter", "JetBrains Mono"],
  "brand_fields": {
    "show_brand": { "type": "boolean", "required": false, "default": false, "description": "Show brand name/handle watermark at bottom. Default: false." },
    "brand_name": { "type": "text", "required": true, "max": 30 },
    "brand_handle": { "type": "text", "required": false, "max": 30 },
    "bg_color": { "type": "bg", "required": false, "default": "#1e1e2e" },
    "bg_color_end": { "type": "bg", "required": false, "default": "#11111b" },
    "accent_color": { "type": "text", "required": false, "default": "#cba6f7" },
    "accent_color_end": { "type": "text", "required": false, "default": "#89b4fa" }
  },
  "slide_fields": {
    "episode_number": { "type": "number", "required": true, "max": 4, "description": "Episode number (displayed large, e.g. 42)" },
    "title": { "type": "text", "required": true, "max": 70, "wrap_width": 30, "description": "Episode title" },
    "guest": { "type": "text", "required": false, "max": 40, "description": "Guest name" },
    "duration": { "type": "text", "required": false, "max": 10, "description": "Duration, e.g. '38 min'" },
    "podcast_name": { "type": "text", "required": true, "max": 40, "description": "Podcast/show name" }
  }
}
