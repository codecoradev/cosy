{
  "id": "author-bio",
  "name": "Author Bio",
  "description": "Profile/bio card with name, role, and description",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP). Rendered with configurable opacity behind gradient overlay."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0)."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG). Rendered at bottom-right corner."
    }
  },
  "slide_fields": {
    "name": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "role": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "bio": {
      "type": "text",
      "required": true,
      "max": 250,
      "wrap_width": 38
    },
    "tag1": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "tag2": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "tag3": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}