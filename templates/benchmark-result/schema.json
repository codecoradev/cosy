{
  "id": "benchmark-result",
  "name": "Benchmark Result",
  "description": "Performance benchmark results card",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "b1_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "b1_ops": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "b1_bar": {
      "type": "text",
      "required": true,
      "max": 5
    },
    "b2_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "b2_ops": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "b2_bar": {
      "type": "text",
      "required": true,
      "max": 5
    },
    "b3_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "b3_ops": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "b3_bar": {
      "type": "text",
      "required": true,
      "max": 5
    },
    "winner": {
      "type": "text",
      "required": false,
      "max": 20
    }
  }
}