{
  "id": "blog-hero",
  "name": "Blog Hero",
  "description": "Wide header image for blog posts and articles",
  "dimensions": {
    "width": 1200,
    "height": 675
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP). Rendered with configurable opacity behind gradient overlay."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0)."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG). Rendered at bottom-right corner."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 150,
      "wrap_width": 32
    },
    "tag": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "read_time": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "date": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}