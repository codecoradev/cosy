{
  "id": "book-club",
  "name": "Book Club",
  "description": "Book recommendation card with cover area, title, author, and rating",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "book_title": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 22
    },
    "author": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "rating": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "takeaway": {
      "type": "text",
      "required": true,
      "max": 150,
      "wrap_width": 35
    },
    "genre": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "pages": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}