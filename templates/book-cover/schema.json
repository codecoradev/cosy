{
  "id": "book-cover",
  "name": "Book Cover",
  "description": "Book/ebook cover design with title and author",
  "dimensions": {
    "width": 1080,
    "height": 1620
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP)."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0)."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG)."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 120,
      "wrap_width": 18
    },
    "subtitle": {
      "type": "text",
      "required": false,
      "max": 150,
      "wrap_width": 30
    },
    "author": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "edition": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}