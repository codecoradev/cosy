{
  "id": "calendar-event",
  "name": "Calendar Event",
  "description": "Calendar-style event card with month header and day number",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "month": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "day": {
      "type": "text",
      "required": true,
      "max": 4
    },
    "day_of_week": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "event_name": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 25
    },
    "time": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "location": {
      "type": "text",
      "required": false,
      "max": 60,
      "wrap_width": 30
    }
  }
}