{
  "id": "carousel-default",
  "name": "Carousel Default",
  "description": "5-slide carousel with eyebrow, headline, body, CTA per slide",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "fonts": ["Inter"],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    }
  },
  "slide_fields": {
    "eyebrow": {
      "type": "text",
      "required": false,
      "max": 50
    },
    "headline": {
      "type": "text",
      "required": true,
      "max": 200,
      "wrap_width": 32
    },
    "body": {
      "type": "text",
      "required": false,
      "max": 400,
      "wrap_width": 45
    },
    "cta": {
      "type": "text",
      "required": false,
      "max": 50
    }
  }
}
