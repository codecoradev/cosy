{
  "id": "carousel-default",
  "name": "Carousel Default",
  "description": "5-slide carousel with eyebrow, headline, body, CTA per slide",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "fonts": [
    "Inter"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#181825"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP). Rendered with configurable opacity behind gradient overlay."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0). Lower = more subtle."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG). Rendered at bottom-right corner."
    }
  },
  "slide_fields": {
    "eyebrow": {
      "type": "text",
      "required": false,
      "max": 50
    },
    "headline": {
      "type": "text",
      "required": true,
      "max": 200,
      "wrap_width": 32
    },
    "body": {
      "type": "text",
      "required": false,
      "max": 400,
      "wrap_width": 45
    }
  }
}