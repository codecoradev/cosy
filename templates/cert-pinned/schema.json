{
  "id": "cert-pinned",
  "name": "Certificate Pinned",
  "description": "SSL/TLS certificate details card",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "domain": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "issuer": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "valid_from": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "valid_to": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "serial": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "algo": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "status": {
      "type": "text",
      "required": true,
      "max": 10
    }
  }
}