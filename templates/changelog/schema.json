{
  "id": "changelog",
  "name": "Changelog",
  "description": "Release changelog card with version and categorized changes",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "version": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "date": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "feature1": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 38
    },
    "feature2": {
      "type": "text",
      "required": false,
      "max": 80,
      "wrap_width": 38
    },
    "feature3": {
      "type": "text",
      "required": false,
      "max": 80,
      "wrap_width": 38
    },
    "fix1": {
      "type": "text",
      "required": false,
      "max": 80,
      "wrap_width": 38
    },
    "fix2": {
      "type": "text",
      "required": false,
      "max": 80,
      "wrap_width": 38
    }
  }
}