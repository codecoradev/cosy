{
  "id": "chart-bar",
  "name": "Bar Chart",
  "description": "Bar chart visualization with multiple data points",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 60,
      "wrap_width": 25
    },
    "b1_label": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "b1_value": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "b2_label": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "b2_value": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "b3_label": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "b3_value": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "b4_label": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "b4_value": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "b5_label": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "b5_value": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}