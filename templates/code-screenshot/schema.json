{
  "id": "code-screenshot",
  "name": "Code Screenshot",
  "dimensions": {
    "width": 1200,
    "height": 675
  },
  "fonts": [
    "Space Grotesk",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "text",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "text",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": false,
      "max": 60,
      "description": "Window title shown in the title bar"
    },
    "filename": {
      "type": "text",
      "required": false,
      "max": 40,
      "description": "Filename shown in the editor tab"
    },
    "code_lang": {
      "type": "text",
      "required": false,
      "max": 12,
      "description": "Language id for syntax highlighting: rust, go, python, typescript, javascript, bash, sql (default: plain)"
    },
    "theme": {
      "type": "text",
      "required": false,
      "max": 8,
      "description": "Editor theme: dark (default) or light"
    },
    "code": {
      "type": "text",
      "required": true,
      "max": 900,
      "options": ["code"],
      "description": "Source code to display. Newlines separate lines; syntax-highlighted per code_lang (keywords mauve, strings green, numbers peach, comments muted)"
    }
  }
}
