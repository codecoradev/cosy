{
  "id": "color-palette",
  "name": "Color Palette",
  "description": "Design color palette showcase with hex codes",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "palette_name": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "color1_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "color1_hex": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "color2_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "color2_hex": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "color3_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "color3_hex": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "color4_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "color4_hex": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "color5_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "color5_hex": {
      "type": "text",
      "required": true,
      "max": 10
    }
  }
}