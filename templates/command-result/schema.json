{
  "id": "command-result",
  "name": "Command Result",
  "description": "CLI command execution result card",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "command": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "exit_code": {
      "type": "text",
      "required": true,
      "max": 5
    },
    "duration": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "stdout_line1": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "stdout_line2": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "stdout_line3": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "stderr_line1": {
      "type": "text",
      "required": false,
      "max": 60
    }
  }
}