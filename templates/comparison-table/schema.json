{
  "id": "comparison-table",
  "name": "Comparison Table",
  "description": "Side-by-side comparison table with two options",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP)."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0)."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG)."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 30
    },
    "option_a_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "option_b_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "row1_label": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "row1_a": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "row1_b": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "row2_label": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "row2_a": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "row2_b": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "row3_label": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "row3_a": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "row3_b": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "row4_label": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "row4_a": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "row4_b": {
      "type": "text",
      "required": false,
      "max": 40
    }
  }
}