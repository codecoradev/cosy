{
  "id": "comparison",
  "name": "Comparison",
  "description": "Before/after comparison",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP). Rendered with configurable opacity behind gradient overlay."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0). Lower = more subtle."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG). Rendered at bottom-right corner."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 25
    },
    "before_label": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "before_text": {
      "type": "text",
      "required": false,
      "max": 150,
      "wrap_width": 30
    },
    "after_label": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "after_text": {
      "type": "text",
      "required": false,
      "max": 150,
      "wrap_width": 30
    }
  }
}