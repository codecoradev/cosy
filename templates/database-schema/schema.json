{
  "id": "database-schema",
  "name": "Database Schema",
  "description": "Database table schema visualization",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "table_name": {
      "type": "text",
      "required": true,
      "max": 25
    },
    "c1_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "c1_type": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "c1_key": {
      "type": "text",
      "required": false,
      "max": 5
    },
    "c2_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "c2_type": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "c2_key": {
      "type": "text",
      "required": false,
      "max": 5
    },
    "c3_name": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "c3_type": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "c3_key": {
      "type": "text",
      "required": false,
      "max": 5
    },
    "c4_name": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "c4_type": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "c4_key": {
      "type": "text",
      "required": false,
      "max": 5
    },
    "c5_name": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "c5_type": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "c5_key": {
      "type": "text",
      "required": false,
      "max": 5
    }
  }
}