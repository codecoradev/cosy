{
  "id": "dependency-graph",
  "name": "Dependency Graph",
  "description": "Dependency tree visualization",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "root": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "child1": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "child2": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "child3": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "leaf1": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "leaf2": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "leaf3": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "leaf4": {
      "type": "text",
      "required": false,
      "max": 20
    }
  }
}