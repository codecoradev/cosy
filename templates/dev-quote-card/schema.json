{
  "id": "dev-quote-card",
  "name": "Dev Quote Card",
  "description": "Developer quote card with large quote text and attribution",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    },
    "bg_overlay_opacity": {
      "type": "number",
      "required": false,
      "default": 0.7,
      "description": "Opacity of the gradient overlay when bg_image is set. 0.0 = photo fully visible, 1.0 = gradient fully covers. Default: 0.7."
    }
  },
  "slide_fields": {
    "quote": {
      "type": "text",
      "required": true,
      "max": 200,
      "wrap_width": 28
    },
    "author": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "role": {
      "type": "text",
      "required": false,
      "max": 50
    },
    "text_color": {
      "type": "color",
      "required": false,
      "description": "Text color for quote/title text as hex (e.g. \"#1e1e2e\"). Use when the background is light. Default: template dark theme color."
    },
    "hashtag": {
      "type": "text",
      "required": false,
      "max": 40,
      "description": "Hashtag shown near the bottom, rendered with a leading # (pass without the # symbol)."
    }
  }
}
