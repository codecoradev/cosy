{
  "id": "dev-quote",
  "name": "Dev Quote",
  "description": "Code-style quote card, square",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP). Rendered with configurable opacity behind gradient overlay."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0). Lower = more subtle."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG). Rendered at bottom-right corner."
    }
  },
  "slide_fields": {
    "code_snippet": {
      "type": "text",
      "required": true,
      "max": 500,
      "wrap_width": 50
    },
    "language": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "filename": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}