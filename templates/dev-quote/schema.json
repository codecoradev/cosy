{
  "id": "dev-quote",
  "name": "Dev Quote",
  "description": "Code-style quote card, square",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "code_snippet": {
      "type": "text",
      "required": true,
      "max": 500,
      "wrap_width": 45
    },
    "language": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "filename": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}