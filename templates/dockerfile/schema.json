{
  "id": "dockerfile",
  "name": "Dockerfile",
  "description": "Dockerfile instructions viewer",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "step1_inst": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "step1_arg": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "step2_inst": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "step2_arg": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "step3_inst": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "step3_arg": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "step4_inst": {
      "type": "text",
      "required": false,
      "max": 8
    },
    "step4_arg": {
      "type": "text",
      "required": false,
      "max": 50
    },
    "step5_inst": {
      "type": "text",
      "required": false,
      "max": 8
    },
    "step5_arg": {
      "type": "text",
      "required": false,
      "max": 50
    }
  }
}