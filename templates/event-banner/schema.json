{
  "id": "event-banner",
  "name": "Event Banner",
  "description": "Event/webinar banner",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "event_name": {
      "type": "text",
      "required": true,
      "max": 100,
      "wrap_width": 30
    },
    "date": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "time": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "speaker": {
      "type": "text",
      "required": false,
      "max": 50
    }
  }
}