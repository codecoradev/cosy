{
  "id": "feature-flags",
  "name": "Feature Flags",
  "description": "Feature flag toggle board",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "f1_name": {
      "type": "text",
      "required": true,
      "max": 25
    },
    "f1_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "f2_name": {
      "type": "text",
      "required": true,
      "max": 25
    },
    "f2_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "f3_name": {
      "type": "text",
      "required": true,
      "max": 25
    },
    "f3_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "f4_name": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "f4_status": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "f5_name": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "f5_status": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}