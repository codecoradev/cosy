{
  "id": "feature-list",
  "name": "Feature List",
  "description": "Product feature list with checkmarks and descriptions",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 60,
      "wrap_width": 25
    },
    "subtitle": {
      "type": "text",
      "required": false,
      "max": 80,
      "wrap_width": 30
    },
    "f1_title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "f1_desc": {
      "type": "text",
      "required": false,
      "max": 60,
      "wrap_width": 35
    },
    "f2_title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "f2_desc": {
      "type": "text",
      "required": false,
      "max": 60,
      "wrap_width": 35
    },
    "f3_title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "f3_desc": {
      "type": "text",
      "required": false,
      "max": 60,
      "wrap_width": 35
    },
    "f4_title": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "f4_desc": {
      "type": "text",
      "required": false,
      "max": 60,
      "wrap_width": 35
    },
    "f5_title": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "f5_desc": {
      "type": "text",
      "required": false,
      "max": 60,
      "wrap_width": 35
    }
  }
}