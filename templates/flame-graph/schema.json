{
  "id": "flame-graph",
  "name": "Flame Graph",
  "description": "Performance profiling flame graph",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "f1_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f1_pct": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "f1_width": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "f2_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f2_pct": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "f2_width": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "f3_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f3_pct": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "f3_width": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "f4_name": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "f4_pct": {
      "type": "text",
      "required": false,
      "max": 8
    },
    "f4_width": {
      "type": "text",
      "required": false,
      "max": 8
    },
    "total_time": {
      "type": "text",
      "required": false,
      "max": 15
    }
  }
}