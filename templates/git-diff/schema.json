{
  "id": "git-diff",
  "name": "Git Diff",
  "description": "Git diff visualization with added and removed lines",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "JetBrains Mono",
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "added1": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "added2": {
      "type": "text",
      "required": false,
      "max": 50
    },
    "removed1": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "removed2": {
      "type": "text",
      "required": false,
      "max": 50
    }
  }
}