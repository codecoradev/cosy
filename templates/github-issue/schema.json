{
  "id": "github-issue",
  "name": "GitHub Issue",
  "description": "GitHub-style issue card with labels, title, and status",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "issue_num": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "title": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 32
    },
    "status": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "label1": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "label2": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "author": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "comments": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}