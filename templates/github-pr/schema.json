{
  "id": "github-pr",
  "name": "GitHub PR",
  "description": "GitHub-style pull request card with merge status",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "pr_num": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "title": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 32
    },
    "branch": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "status": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "additions": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "deletions": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "files_changed": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}