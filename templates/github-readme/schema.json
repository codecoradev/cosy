{
  "id": "github-readme",
  "name": "GitHub README Banner",
  "description": "README banner for repos",
  "dimensions": {
    "width": 1280,
    "height": 640
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 100,
      "wrap_width": 35
    },
    "description": {
      "type": "text",
      "required": false,
      "max": 300,
      "wrap_width": 60
    },
    "tech_stack": {
      "type": "text",
      "required": false,
      "max": 100
    }
  }
}