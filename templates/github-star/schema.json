{
  "id": "github-star",
  "name": "GitHub Star",
  "description": "GitHub repository showcase card with stars and description",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "repo_name": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "description": {
      "type": "text",
      "required": true,
      "max": 150,
      "wrap_width": 40
    },
    "stars": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "language": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "forks": {
      "type": "text",
      "required": false,
      "max": 20
    }
  }
}