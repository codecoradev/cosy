{
  "id": "goal-tracker",
  "name": "Goal Tracker",
  "description": "Annual goal tracker with circular progress and milestones",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 60,
      "wrap_width": 25
    },
    "current": {
      "type": "number",
      "required": true,
      "default": 0,
      "description": "Progress numbers; arc renders current/target of the ring"
    },
    "target": {
      "type": "number",
      "required": true,
      "default": 0,
      "description": "Progress numbers; arc renders current/target of the ring"
    },
    "unit": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "goal1": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "goal1_done": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "goal2": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "goal2_done": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "goal3": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "goal3_done": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "goal4": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "goal4_done": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}
