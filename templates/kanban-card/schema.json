{
  "id": "kanban-card",
  "name": "Kanban Card",
  "description": "Kanban-style board with columns: todo, doing, done",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "todo1": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "todo2": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "doing1": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "doing2": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "done1": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "done2": {
      "type": "text",
      "required": false,
      "max": 40
    }
  }
}