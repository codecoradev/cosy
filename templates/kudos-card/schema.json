{
  "id": "kudos-card",
  "name": "Kudos Card",
  "description": "Appreciation and recognition card for team members",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "recipient": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "from_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "reason": {
      "type": "text",
      "required": true,
      "max": 100,
      "wrap_width": 35
    },
    "badge": {
      "type": "text",
      "required": false,
      "max": 15
    }
  }
}