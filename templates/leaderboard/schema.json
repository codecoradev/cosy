{
  "id": "leaderboard",
  "name": "Leaderboard",
  "description": "Ranked leaderboard display",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "e1_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "e1_score": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "e2_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "e2_score": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "e3_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "e3_score": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "e4_name": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "e4_score": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "e5_name": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "e5_score": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}