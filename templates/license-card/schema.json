{
  "id": "license-card",
  "name": "License Card",
  "description": "Open source license information card",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "license_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "license_spdx": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "description": {
      "type": "text",
      "required": true,
      "max": 120,
      "wrap_width": 38
    },
    "permissions": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "conditions": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "limitations": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "copyright_year": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "copyright_holder": {
      "type": "text",
      "required": false,
      "max": 40
    }
  }
}