{
  "id": "log-viewer",
  "name": "Log Viewer",
  "description": "Server log output viewer card",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "l1_time": {
      "type": "text",
      "required": true,
      "max": 12
    },
    "l1_level": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "l1_msg": {
      "type": "text",
      "required": true,
      "max": 55
    },
    "l2_time": {
      "type": "text",
      "required": true,
      "max": 12
    },
    "l2_level": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "l2_msg": {
      "type": "text",
      "required": true,
      "max": 55
    },
    "l3_time": {
      "type": "text",
      "required": false,
      "max": 12
    },
    "l3_level": {
      "type": "text",
      "required": false,
      "max": 8
    },
    "l3_msg": {
      "type": "text",
      "required": false,
      "max": 55
    },
    "l4_time": {
      "type": "text",
      "required": false,
      "max": 12
    },
    "l4_level": {
      "type": "text",
      "required": false,
      "max": 8
    },
    "l4_msg": {
      "type": "text",
      "required": false,
      "max": 55
    }
  }
}