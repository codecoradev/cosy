{
  "id": "migration-status",
  "name": "Migration Status",
  "description": "Database migration progress tracker",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "m1_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "m1_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "m2_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "m2_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "m3_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "m3_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "m4_name": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "m4_status": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "m5_name": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "m5_status": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "m6_name": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "m6_status": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
