{
  "id": "minimal-text",
  "name": "Minimal Text",
  "description": "Ultra-minimal text-only card, just words on gradient",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "line1": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "line2": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "line3": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "alignment": {
      "type": "text",
      "required": false,
      "max": 10,
      "description": "left, center, or right (default center)"
    }
  }
}