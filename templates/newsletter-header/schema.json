{
  "id": "newsletter-header",
  "name": "Newsletter Header",
  "description": "Email newsletter header banner",
  "dimensions": {
    "width": 1200,
    "height": 400
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "issue_number": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "title": {
      "type": "text",
      "required": true,
      "max": 120,
      "wrap_width": 35
    },
    "date": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}