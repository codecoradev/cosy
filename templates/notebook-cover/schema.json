      "description": "Pipeline label 5."
    },
    "label6": {
      "type": "text",
      "required": true,
      "max": 14,
      "description": "Pipeline label 6."
    },
    "intro_lead": {
      "type": "text",
      "required": true,
      "max": 20,
      "description": "Bold lead inside dashed intro box (purple)."
    },
    "intro_text": {
      "type": "text",
      "required": true,
      "max": 150,
      "description": "Intro sentence (wrapped)."
    },
    "toc_title": {
