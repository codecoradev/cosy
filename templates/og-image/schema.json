{
  "id": "og-image",
  "name": "OG Image",
  "description": "Open Graph image (1200×630) for blog posts and social previews",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": ["Inter"],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 200,
      "wrap_width": 38
    },
    "subtitle": {
      "type": "text",
      "required": false,
      "max": 150,
      "wrap_width": 50
    },
    "author": {
      "type": "text",
      "required": false,
      "max": 50
    },
    "url": {
      "type": "text",
      "required": false,
      "max": 100
    }
  }
}
