{
  "id": "package-json",
  "name": "Package JSON",
  "description": "package.json style card with dependency listing",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "dep1_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "dep1_version": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "dep2_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "dep2_version": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "dep3_name": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "dep3_version": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "dep4_name": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "dep4_version": {
      "type": "text",
      "required": false,
      "max": 15
    }
  }
}