{
  "id": "poll-result",
  "name": "Poll Result",
  "description": "Poll results visualization with percentage bars",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP). Rendered with configurable opacity behind gradient overlay."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0)."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG). Rendered at bottom-right corner."
    }
  },
  "slide_fields": {
    "question": {
      "type": "text",
      "required": true,
      "max": 120,
      "wrap_width": 35
    },
    "option_a": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "option_a_pct": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "option_b": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "option_b_pct": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "option_c": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "option_c_pct": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "option_d": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "option_d_pct": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "total_votes": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}