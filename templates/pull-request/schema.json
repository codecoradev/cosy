{
  "id": "pull-request",
  "name": "Pull Request",
  "description": "GitHub pull request review card",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "pr_number": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "pr_title": {
      "type": "text",
      "required": true,
      "max": 60,
      "wrap_width": 35
    },
    "author": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "branch": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "base_branch": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "status": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "additions": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "deletions": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}