{
  "id": "recipe-card",
  "name": "Recipe Card",
  "description": "Recipe card with title, ingredients list, and steps",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "recipe_name": {
      "type": "text",
      "required": true,
      "max": 60,
      "wrap_width": 25
    },
    "servings": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "time": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "ingredients": {
      "type": "text",
      "required": true,
      "max": 300,
      "wrap_width": 35
    },
    "step1": {
      "type": "text",
      "required": true,
      "max": 120,
      "wrap_width": 35
    },
    "step2": {
      "type": "text",
      "required": false,
      "max": 120,
      "wrap_width": 35
    },
    "step3": {
      "type": "text",
      "required": false,
      "max": 120,
      "wrap_width": 35
    }
  }
}