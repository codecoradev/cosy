{
  "id": "review-card",
  "name": "Review Card",
  "description": "Product review card with star rating and review text",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "product_name": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "rating": {
      "type": "text",
      "required": true,
      "max": 10,
      "description": "Rating as number e.g. 4.5"
    },
    "max_rating": {
      "type": "text",
      "required": false,
      "max": 5,
      "default": "5"
    },
    "review_text": {
      "type": "text",
      "required": true,
      "max": 250,
      "wrap_width": 38
    },
    "reviewer": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "source": {
      "type": "text",
      "required": false,
      "max": 40
    }
  }
}