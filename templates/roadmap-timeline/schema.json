{
  "id": "roadmap-timeline",
  "name": "Roadmap Timeline",
  "description": "Project roadmap with horizontal timeline",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "q1_label": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "q1_items": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "q2_label": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "q2_items": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "q3_label": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "q3_items": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "q4_label": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "q4_items": {
      "type": "text",
      "required": true,
      "max": 40
    }
  }
}