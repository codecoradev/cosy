{
  "id": "security-advisory",
  "name": "Security Advisory",
  "description": "Security vulnerability advisory card",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "severity": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "cve": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "affected": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "description": {
      "type": "text",
      "required": true,
      "max": 120,
      "wrap_width": 45
    },
    "fix_version": {
      "type": "text",
      "required": false,
      "max": 15
    }
  }
}