  "slides": [
    {
      "title": "Template query",
      "filename": "query.sql",
      "line1": "SELECT t.id, t.name, t.created_at,",
      "line2": "       COUNT(r.id) as render_count",
      "line3": "FROM templates t",
      "line4": "LEFT JOIN renders r ON r.template_id = t.id",
      "line5": "WHERE t.is_active = true",
      "line6": "GROUP BY t.id ORDER BY render_count DESC"
    }
  ]
}