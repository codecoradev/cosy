{
  "id": "social-poll",
  "name": "Social Poll",
  "description": "Poll card with question and visual percentage bars",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "question": {
      "type": "text",
      "required": true,
      "max": 100,
      "wrap_width": 30
    },
    "opt1": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "opt1_pct": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "opt2": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "opt2_pct": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "opt3": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "opt3_pct": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}