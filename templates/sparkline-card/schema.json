{
  "id": "sparkline-card",
  "name": "Sparkline Card",
  "dimensions": { "width": 1080, "height": 1080 },
  "fonts": ["Space Grotesk", "Inter", "JetBrains Mono"],
  "brand_fields": {
    "show_brand": { "type": "boolean", "required": false, "default": false, "description": "Show brand name/handle watermark at bottom. Default: false." },
    "brand_name": { "type": "text", "required": true, "max": 30 },
    "brand_handle": { "type": "text", "required": false, "max": 30 },
    "bg_color": { "type": "bg", "required": false, "default": "#1e1e2e" },
    "bg_color_end": { "type": "bg", "required": false, "default": "#11111b" },
    "accent_color": { "type": "text", "required": false, "default": "#cba6f7" },
    "accent_color_end": { "type": "text", "required": false, "default": "#89b4fa" }
  },
  "slide_fields": {
    "label": { "type": "text", "required": true, "max": 40, "description": "Metric label (e.g. 'Weekly downloads')" },
    "value": { "type": "text", "required": true, "max": 12, "description": "Current headline value (e.g. '12.4K')" },
    "delta": { "type": "text", "required": false, "max": 10, "description": "Change vs previous period, e.g. '+18%'" },
    "points": { "type": "text", "required": true, "max": 200, "description": "Comma-separated numbers for the sparkline (8-24 values), e.g. '12,18,15,22,19,28,31,27,35'" },
    "period": { "type": "text", "required": false, "max": 30, "description": "Period caption under the sparkline, e.g. 'last 9 weeks'" }
  }
}
