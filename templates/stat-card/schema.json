{
  "id": "stat-card",
  "name": "Stat Card",
  "description": "Single statistic highlight, square",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "stat_number": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "stat_label": {
      "type": "text",
      "required": true,
      "max": 150,
      "wrap_width": 25
    },
    "source": {
      "type": "text",
      "required": false,
      "max": 100
    }
  }
}