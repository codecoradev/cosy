{
  "id": "status-badge",
  "name": "Status Badge",
  "description": "Large status badge display",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "service": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "status": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "uptime": {
      "type": "text",
      "required": false,
      "max": 10
    },
    "response_time": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "last_incident": {
      "type": "text",
      "required": false,
      "max": 20
    }
  }
}