{
  "id": "swagger-endpoint",
  "name": "Swagger Endpoint",
  "description": "OpenAPI/Swagger endpoint documentation card",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "method": {
      "type": "text",
      "required": true,
      "max": 8
    },
    "path": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "description": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 45
    },
    "auth": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "response_code": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "response_desc": {
      "type": "text",
      "required": true,
      "max": 40
    }
  }
}