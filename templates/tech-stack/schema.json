{
  "id": "tech-stack",
  "name": "Tech Stack",
  "description": "Technology stack grid showing tools and frameworks",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "t1_name": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "t1_desc": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "t2_name": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "t2_desc": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "t3_name": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "t3_desc": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "t4_name": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "t4_desc": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "t5_name": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "t5_desc": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "t6_name": {
      "type": "text",
      "required": false,
      "max": 15
    },
    "t6_desc": {
      "type": "text",
      "required": false,
      "max": 25
    }
  }
}