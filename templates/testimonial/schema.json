{
  "id": "testimonial",
  "name": "Testimonial",
  "description": "Customer testimonial card",
  "dimensions": {
    "width": 1080,
    "height": 1200
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "quote": {
      "type": "text",
      "required": true,
      "max": 300,
      "wrap_width": 38
    },
    "author_name": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "author_role": {
      "type": "text",
      "required": false,
      "max": 50
    },
    "author_company": {
      "type": "text",
      "required": false,
      "max": 50
    }
  }
}