{
  "id": "timeline",
  "name": "Timeline",
  "description": "Vertical timeline with milestones and dates",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path (PNG/JPG/WebP)."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15,
      "description": "Opacity of background image (0.0-1.0)."
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path (PNG/SVG)."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 30
    },
    "milestone1_date": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "milestone1_text": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 30
    },
    "milestone2_date": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "milestone2_text": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 30
    },
    "milestone3_date": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "milestone3_text": {
      "type": "text",
      "required": true,
      "max": 80,
      "wrap_width": 30
    },
    "milestone4_date": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "milestone4_text": {
      "type": "text",
      "required": false,
      "max": 80,
      "wrap_width": 30
    }
  }
}