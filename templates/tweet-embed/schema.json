{
  "id": "tweet-embed",
  "name": "Tweet Embed",
  "description": "Tweet-style card with avatar circle, name, handle, and text",
  "dimensions": {
    "width": 1200,
    "height": 675
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "name": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "handle": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "tweet": {
      "type": "text",
      "required": true,
      "max": 280,
      "wrap_width": 45
    },
    "date": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}