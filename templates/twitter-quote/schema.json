{
  "id": "twitter-quote",
  "name": "Twitter/X Quote",
  "description": "Quote card for X/Twitter",
  "dimensions": {
    "width": 1200,
    "height": 675
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "quote": {
      "type": "text",
      "required": true,
      "max": 280,
      "wrap_width": 35
    },
    "author": {
      "type": "text",
      "required": true,
      "max": 50
    },
    "handle": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}