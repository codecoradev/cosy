{
  "id": "uptime-monitor",
  "name": "Uptime Monitor",
  "description": "Service uptime monitoring dashboard",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "overall_uptime": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "s1_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "s1_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "s2_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "s2_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "s3_name": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "s3_status": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "s4_name": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "s4_status": {
      "type": "text",
      "required": false,
      "max": 10
    }
  }
}