{
  "id": "version-compare",
  "name": "Version Compare",
  "description": "Side-by-side version comparison",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "show_brand": {
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Show brand name/handle watermark at bottom. Default: false."
    },
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "v_old": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "v_new": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "metric": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "old_val": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "new_val": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "delta": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "delta_dir": {
      "type": "text",
      "required": true,
      "max": 4
    }
  }
}