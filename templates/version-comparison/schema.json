{
  "id": "version-comparison",
  "name": "Version Comparison",
  "description": "Side-by-side software version comparison",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "fonts": [
    "Inter",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "v1_label": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "v2_label": {
      "type": "text",
      "required": true,
      "max": 15
    },
    "f1_name": {
      "type": "text",
      "required": true,
      "max": 25
    },
    "f1_v1": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f1_v2": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f2_name": {
      "type": "text",
      "required": true,
      "max": 25
    },
    "f2_v1": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f2_v2": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f3_name": {
      "type": "text",
      "required": true,
      "max": 25
    },
    "f3_v1": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f3_v2": {
      "type": "text",
      "required": true,
      "max": 20
    },
    "f4_name": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "f4_v1": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "f4_v2": {
      "type": "text",
      "required": false,
      "max": 20
    }
  }
}