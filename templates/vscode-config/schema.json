{
  "id": "vscode-config",
  "name": "VS Code Config",
  "description": "VS Code settings JSON snippet card",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "key1": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "value1": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "key2": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "value2": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "key3": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "value3": {
      "type": "text",
      "required": false,
      "max": 40
    }
  }
}