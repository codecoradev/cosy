{
  "id": "webhook-card",
  "name": "Webhook Card",
  "description": "API endpoint card showing method, path, and response",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false,
      "description": "Background image path."
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false,
      "description": "Brand logo path."
    }
  },
  "slide_fields": {
    "method": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "endpoint": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "description": {
      "type": "text",
      "required": false,
      "max": 120,
      "wrap_width": 40
    },
    "status_code": {
      "type": "text",
      "required": true,
      "max": 10
    },
    "response_field": {
      "type": "text",
      "required": false,
      "max": 40
    },
    "response_type": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}