{
  "id": "webhook-payload",
  "name": "Webhook Payload",
  "description": "Incoming webhook event payload viewer",
  "dimensions": {
    "width": 1200,
    "height": 630
  },
  "fonts": [
    "Inter",
    "JetBrains Mono",
    "Space Grotesk"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    },
    "bg_image": {
      "type": "image",
      "required": false
    },
    "bg_image_opacity": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "logo": {
      "type": "image",
      "required": false
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 40
    },
    "event": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "source": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "timestamp": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "delivery_id": {
      "type": "text",
      "required": false,
      "max": 25
    },
    "json_line1": {
      "type": "text",
      "required": true,
      "max": 60
    },
    "json_line2": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "json_line3": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "json_line4": {
      "type": "text",
      "required": false,
      "max": 60
    },
    "json_line5": {
      "type": "text",
      "required": false,
      "max": 60
    }
  }
}