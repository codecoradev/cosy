{
  "id": "youtube-thumb",
  "name": "YouTube Thumbnail",
  "description": "Eye-catching YouTube thumbnail",
  "dimensions": {
    "width": 1280,
    "height": 720
  },
  "fonts": [
    "Inter",
    "JetBrains Mono"
  ],
  "brand_fields": {
    "brand_name": {
      "type": "text",
      "required": true,
      "max": 30
    },
    "brand_handle": {
      "type": "text",
      "required": false,
      "max": 30
    },
    "bg_color": {
      "type": "bg",
      "required": false,
      "default": "#1e1e2e"
    },
    "bg_color_end": {
      "type": "bg",
      "required": false,
      "default": "#11111b"
    },
    "accent_color": {
      "type": "bg",
      "required": false,
      "default": "#cba6f7"
    },
    "accent_color_end": {
      "type": "bg",
      "required": false,
      "default": "#89b4fa"
    }
  },
  "slide_fields": {
    "title": {
      "type": "text",
      "required": true,
      "max": 120,
      "wrap_width": 30
    },
    "episode": {
      "type": "text",
      "required": false,
      "max": 20
    },
    "tag": {
      "type": "text",
      "required": false,
      "max": 30
    }
  }
}